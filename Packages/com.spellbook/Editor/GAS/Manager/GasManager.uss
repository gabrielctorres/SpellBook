/* Gerenciador do GAS (DS ferramentas-do-editor, seção 5). O tema escuro é o padrão; .gas-manager--light troca os valores
   do token, que vem do DS do Inspector de ações. */
.gas-manager { --spellbook-text-secondary: #9a9a9a; --spellbook-warning: #e6b400; --spellbook-error: #ff5c5c; }
.gas-manager--light { --spellbook-text-secondary: #5a5a5a; --spellbook-warning: #8a6400; --spellbook-error: #c00000; }

.gas-manager .unity-two-pane-split-view { flex-grow: 1; }
.gas-manager .unity-list-view, .gas-manager .unity-tree-view { flex-grow: 1; }
.gas-manager__secondary { color: var(--spellbook-text-secondary); margin: 0 4px; }
.gas-manager__chips { flex-direction: row; flex-wrap: wrap; }
.gas-manager__chip { border-radius: 8px; }
.gas-manager__row { flex-direction: row; align-items: center; height: 100%; }
.gas-manager__row > Image { width: 16px; height: 16px; margin: 0 4px; }
.gas-manager__row--header { -unity-font-style: bold; }
.gas-manager__detail { padding: 4px; }
#gas-manager__title { -unity-font-style: bold; font-size: 14px; margin-bottom: 4px; }
.gas-manager__group { -unity-font-style: bold; margin-top: 8px; }
.gas-manager__reference { flex-direction: row; align-items: center; -unity-text-align: middle-left; }
.gas-manager__reference > Image { width: 16px; height: 16px; margin-right: 4px; }
.gas-manager__footer { flex-direction: row; justify-content: flex-end; padding: 4px; }
.gas-manager Button:focus, .gas-manager .unity-collection-view__item:focus { border-width: 2px; }

.gas-manager__warning { color: var(--spellbook-warning); white-space: normal; }

/* Diálogos Duplicar, Renomear, Excluir e Nova tag filha (DS, seção 6). */
.gas-dialog { padding: 8px; }
.gas-dialog__list { flex-grow: 1; margin: 4px 0; }
#gas-dialog__title { -unity-font-style: bold; font-size: 14px; margin-bottom: 4px; }
.gas-dialog__danger { color: var(--spellbook-error); }
