# Projeto Unity host local (não faz parte do pacote)
/Assets/
/Library/
/Logs/
/Packages/
/ProjectSettings/
/UserSettings/
/Temp/
/obj/
/Build/
/Builds/
/MemoryCaptures/
/Recordings/

# Projeto host de testes (HostProject~/): só Packages/ e ProjectVersion.txt são versionados
/HostProject~/Library/
/HostProject~/Logs/
/HostProject~/Temp/
/HostProject~/UserSettings/
/HostProject~/obj/
/HostProject~/ProjectSettings/*
!/HostProject~/ProjectSettings/ProjectVersion.txt

# Arquivos gerados por IDEs
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.user
*.suo
*.pidb
*.booproj
*.userprefs

# Sistema operacional
.DS_Store
Thumbs.db

# Time de agentes (lock local do Unity Editor)
.claude/editor.lock
.claude/settings.local.json
